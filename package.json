{
  "name": "react-automat",
  "version": "0.1.0",
  "type": "module",
  "description": "Higher-order state container for React PureComponents — state independent of component lifecycle",
  "license": "0BSD",
  "main": "./dist/react-automat.umd.js",
  "module": "./dist/react-automat.es.js",
  "types": "./src/lib/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebseb7/react-automat.git"
  },
  "bugs": {
    "url": "https://github.com/sebseb7/react-automat/issues"
  },
  "homepage": "https://sebgreen.net/automat/",
  "files": [
    "dist/react-automat.es.js",
    "dist/react-automat.umd.js",
    "src/lib",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/lib/index.d.ts",
      "import": "./dist/react-automat.es.js",
      "require": "./dist/react-automat.umd.js",
      "default": "./dist/react-automat.es.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview"
  },
  "keywords": [
    "react",
    "react-automat",
    "state",
    "purecomponent",
    "higher-order-state",
    "state-management",
    "suspense",
    "indexeddb",
    "sse",
    "offline",
    "lightweight"
  ],
  "peerDependencies": {
    "react": ">=16.8.0 || >=17.0.0 || >=18.0.0 || >=19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
